# MongoDB connection string
DATABASE_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/database?retryWrites=true&w=majority

# Server configuration
PORT=4019
BACKEND_BASE_URL=http://localhost:4019

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Bucket configuration
BUCKET_NAME=your_bucket_name
BUCKET_REGION=your_bucket_region
BUCKET_ACCESS_KEY=your_access_key
BUCKET_SECRET_KEY=your_secret_key
BUCKET_ENDPOINT=your_bucket_endpoint

# Bull Board configuration
BULLBOARD_PASSWORD=admin123

# JWT configuration
JWT_SECRET=your_jwt_secret
JWT_COMMAND=openssl rand -hex 32
GEN_SALT=10
EXPIRES_IN=15d

# Email configuration
EMAIL=your_email@example.com
APP_PASS=your_app_password

# OpenAI configuration for GPT-3.5-turbo
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-3.5-turbo

# Recipe scraping source used by the scraped-recipes endpoint
SCRAPED_RECIPES_SOURCE_URL=https://example.com/recipes

# Encryption key for sensitive data (must be 32 bytes for AES-256)
ENCRYPTION_KEY=your_encryption_key
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# OpenAI configuration for GPT-5-nano (uncomment if needed)
#OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-5-nano
